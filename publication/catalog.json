    {
      "id": "https://governedlogic.com/",
      "title": "Governed Logic Reasoning Systems",
      "url": "https://governedlogic.com/",
      "path": "/",
      "type": "page",
      "canonicalUrl": "https://governedlogic.com/",
      "sourcePath": "index.html",
      "sha256_html": "6848010e3b467e831f8a8baa5c869fb42f9abfeef0d72d17d95a4741b82728db",
      "sha256_text": "b8174cee4528128d34d6271af9eced7f3dc44eb2b4318bf958b9c9e1c2b53e83",
      "text_hash_scope": "main element and homepage hero; decoded text nodes; block separators; NFC; whitespace collapsed; UTF-8; extractor v1",
      "links": [],
      "author": "Paul André Couchoud",
      "description": "Governed Logic is a substrate-agnostic reasoning architecture developed by Paul André Couchoud in which truth governs logic, logic governs reasoning, and intelligence is downstream. Its philosophical foundation is developed in On the Nature of Ultimate Grounding. Governed Intelligence is the artificial-intelligence implementation of that architecture.",
      "status": "published"
    },
