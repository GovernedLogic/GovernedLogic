      "sha256_html": "e8f476040dd169192ad5043211b2d07594c9a01a1755d049624cff2741c5f222",
      "sha256_text": "6aac8048645a53b078c9c3ccf86f11efa34aa95cd3f763b7f2ec8a2daa2be628",
      "text_hash_scope": "main element and homepage hero; decoded text nodes; block separators; NFC; whitespace collapsed; UTF-8; extractor v1",
      "links": [],
      "author": "Paul André Couchoud",
      "version": "19.4",
